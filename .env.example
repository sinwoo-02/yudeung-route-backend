# ==========================================
# 진주시 유등축제 환경 변수 설정 템플릿 (.env.example)
# 복사하여 .env 파일을 생성한 뒤 실제 값을 입력하세요:
# cp .env.example .env
# ==========================================

# 실행 프로파일 (dev: H2 인메모리 DB, prod: PostgreSQL)
SPRING_PROFILES_ACTIVE=dev

# 카카오 REST API 키
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here

# 공공데이터포털 서비스 키
DATA_PORTAL_SERVICE_KEY=your_data_portal_service_key_here

# 공공데이터 실시간 주차장 동기화 여부
DATA_PORTAL_SYNC_ENABLED=true

# ==========================================
# 운영 환경 (SPRING_PROFILES_ACTIVE=prod) PostgreSQL 설정
# dev 환경에서는 아래 항목을 설정할 필요가 없습니다.
# ==========================================
# DB_URL=jdbc:postgresql://localhost:5432/yudeung_db
# DB_USERNAME=postgres
# DB_PASSWORD=your_db_password_here
# JPA_DDL_AUTO=validate
# SWAGGER_ENABLED=false
